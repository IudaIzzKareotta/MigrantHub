# Application
# One of: dev, staging, production
APP_ENV=dev

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=55432
DB_USER=migranthub
DB_PASSWORD=migranthub
DB_NAME=migranthub
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s

# Auth
AUTH_JWT_SECRET=dev-only-insecure-secret-please-change-in-production
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
